{
  "xsappname": "BTP_CAPM",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.Display",
      "description": "display"
    },
    {
      "name": "$XSAPPNAME.Edit",
      "description": "edit"
    },
    {
      "name": "$XSAPPNAME.Delete",
      "description": "delete"
    }
  ],
  "attributes": [
    {
      "name": "loginName",
      "description": "The login name which will follow the row level security",
      "valueType": "string"
    }
  ],
  "role-templates": [
    {
      "name": "Viewer",
      "description": "View all the data of PO and Employees",
      "default-role-name": "Viewer: Authorized to Read PO and Employees",
      "scope-references": [
        "$XSAPPNAME.Display"
      ],
      "attribute-references": [
        "loginName"
      ]
    },
    {
      "name": "Editor",
      "description": "Edit, delete PO and Employees",
      "scope-references": [
        "$XSAPPNAME.Edit",
        "$XSAPPNAME.Delete"
      ]
    }
  ],
  "role-collections": [
    {
      "name": "UserViewerRC",
      "description": "User Viewer Role Collection",
      "role-template-references": [
        "$XSAPPNAME.Viewer"
      ]
    }
  ],
  "authorities": [
    "$ACCEPT_GRANTED_AUTHORITIES"
  ],
  "oauth2-configuration": {
    "token-validity": 9000,
    "redirect-uris": [
      "https://*.cfapps.us10-001.hana.ondemand.com/login/callback"
    ]
  },
  "xsenableasyncservice": "true"
}